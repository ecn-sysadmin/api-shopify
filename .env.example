# Copia este archivo como .env (o captura estas variables en el panel Node.js de cPanel)

# Clave que Power Automate enviará en el header x-api-key (genera una larga y aleatoria)
API_KEY=cambia-esto-por-una-clave-larga

# Solo si la app quedó en una subruta, ej. /api-ns. Si está en la raíz del dominio, déjalo vacío.
BASE_PATH=

# NetSuite - Token-Based Authentication
NS_ACCOUNT_ID=1234567            # sandbox: 1234567_SB1
NS_CONSUMER_KEY=
NS_CONSUMER_SECRET=
NS_TOKEN_ID=
NS_TOKEN_SECRET=

SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID = 
SHOPIFY_CLIENTE _SECRET = 

# Consulta para la prueba (opcional)
NS_TEST_QUERY=SELECT id, name FROM currency
